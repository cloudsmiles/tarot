.screen {
  min-height: 100vh;
  padding: 52rpx 44rpx 44rpx;
  display: flex;
  flex-direction: column;
}

button {
  margin: 0;
  padding: 0;
  font-size: inherit;
  line-height: normal;
  background: transparent;
  color: inherit;
  border-radius: 0;
}
button::after { border: none; }

/* 问卜 */
.brand { text-align: center; margin: 56rpx 0 52rpx; }
.brand-mark { font-size: 68rpx; color: #d8b25c; line-height: 1; }
.brand-title { font-size: 50rpx; font-weight: 700; letter-spacing: 8rpx; margin: 24rpx 0 16rpx; }
.brand-sub { font-size: 26rpx; color: #b6aecb; }

.ask-card {
  background: rgba(21, 15, 51, 0.72);
  border: 1rpx solid rgba(216, 178, 92, 0.28);
  border-radius: 36rpx;
  padding: 44rpx 40rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.28);
}
.field-label { font-size: 25rpx; letter-spacing: 4rpx; color: #b6aecb; margin-bottom: 24rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 20rpx; }
.chip {
  padding: 18rpx 30rpx;
  font-size: 27rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(216, 178, 92, 0.28);
  color: #efe8d8;
  background: rgba(255, 255, 255, 0.04);
}
.chip.is-sel {
  background: linear-gradient(135deg, #e8c879, #b78d3a);
  color: #2a1f04;
  font-weight: 600;
}

.question-input {
  width: 100%;
  min-height: 88rpx;
  background: rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(216, 178, 92, 0.28);
  border-radius: 24rpx;
  color: #efe8d8;
  font-size: 29rpx;
  line-height: 1.6;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}
.ph { color: rgba(182, 174, 203, 0.55); }

.spread-info {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 36rpx 0 32rpx;
  font-size: 25rpx;
  color: #b6aecb;
}
.dot-sep { color: #d8b25c; font-size: 18rpx; }

.btn-primary {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 999rpx;
  font-size: 31rpx;
  letter-spacing: 6rpx;
  font-weight: 600;
  color: #2a1f04;
  background: linear-gradient(135deg, #e8c879, #b78d3a);
  box-shadow: 0 16rpx 48rpx rgba(183, 141, 58, 0.3);
}
button.btn-primary[disabled] {
  color: rgba(42, 31, 4, 0.6);
  background: linear-gradient(135deg, rgba(232, 200, 121, 0.35), rgba(183, 141, 58, 0.35));
  box-shadow: none;
}
.btn-small { width: 360rpx; padding: 22rpx 0; font-size: 28rpx; }

.proto-note { text-align: center; font-size: 23rpx; color: #b6aecb; opacity: 0.7; margin-top: 36rpx; }

/* 抽牌 */
.draw-head { text-align: center; margin: 40rpx 0 20rpx; }
.draw-question { font-size: 32rpx; color: #d8b25c; }
.draw-hint { font-size: 25rpx; color: #b6aecb; margin-top: 16rpx; min-height: 36rpx; }

.pick-progress { text-align: center; margin: 20rpx 0 8rpx; animation: dealIn 0.4s ease 0.5s both; }
.pick-num { font-size: 44rpx; color: #d8b25c; font-weight: 700; }
.pick-total { font-size: 30rpx; color: #b6aecb; }

.tray { display: flex; justify-content: center; gap: 36rpx; margin: 28rpx 0; animation: dealIn 0.4s ease 0.42s both; }
.tray-slot {
  width: 120rpx;
  height: 204rpx;
  border: 1rpx dashed rgba(216, 178, 92, 0.5);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.25s;
}
.tray-num { font-size: 26rpx; color: #b6aecb; }
.tray-slot.is-filled {
  border: 1rpx solid #d8b25c;
  background: radial-gradient(circle at 50% 35%, #2c2360, #120d33);
  box-shadow: 0 0 28rpx rgba(216, 178, 92, 0.25);
}
.tray-slot.is-filled .tray-num { color: #d8b25c; }

/* 洗牌舞台 */
.shuffle-stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
}
.shuffle-deck { position: relative; width: 192rpx; height: 328rpx; }
.shuffle-card {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #caa866;
  background: radial-gradient(circle at 50% 35%, #2c2360, #120d33);
  box-shadow: inset 0 0 0 6rpx rgba(216, 178, 92, 0.18), 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  animation-duration: 0.7s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.shuffle-card .back-emblem { font-size: 56rpx; }
.sc1 { z-index: 1; animation-name: shuffleCut1; }
.sc2 { z-index: 2; animation-name: shuffleCut2; animation-delay: 0.09s; }
.sc3 { z-index: 3; animation-name: shuffleCut3; animation-delay: 0.18s; }
.sc4 { z-index: 4; animation-name: shuffleCut4; animation-delay: 0.27s; }
.sc5 { z-index: 5; animation-name: shuffleCut5; animation-delay: 0.36s; }
@keyframes shuffleCut1 {
  0%, 100% { transform: translateX(-20rpx); }
  35% { transform: translateX(-124rpx) translateY(-20rpx) rotate(-7deg); }
  70% { transform: translateX(-20rpx); }
}
@keyframes shuffleCut2 {
  0%, 100% { transform: translateX(-10rpx); }
  35% { transform: translateX(102rpx) translateY(-20rpx) rotate(6deg); }
  70% { transform: translateX(-10rpx); }
}
@keyframes shuffleCut3 {
  0%, 100% { transform: translateX(0); }
  35% { transform: translateX(-96rpx) translateY(-20rpx) rotate(-5deg); }
  70% { transform: translateX(0); }
}
@keyframes shuffleCut4 {
  0%, 100% { transform: translateX(10rpx); }
  35% { transform: translateX(110rpx) translateY(-20rpx) rotate(7deg); }
  70% { transform: translateX(10rpx); }
}
@keyframes shuffleCut5 {
  0%, 100% { transform: translateX(20rpx); }
  35% { transform: translateX(-108rpx) translateY(-20rpx) rotate(-6deg); }
  70% { transform: translateX(20rpx); }
}

.river-mount { height: 260rpx; margin: 16rpx -44rpx 28rpx; }
.river { white-space: nowrap; height: 100%; }
.mini-card {
  position: relative;
  display: inline-flex;
  width: 120rpx;
  height: 204rpx;
  margin-right: 16rpx;
  vertical-align: top;
  transition: transform 0.38s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
}
.river-mount.is-deal-hidden { opacity: 0; }
.mini-card:first-child { margin-left: 44rpx; }
.mini-card:last-child { margin-right: 100rpx; }
@keyframes dealIn {
  from { opacity: 0; transform: translateY(48rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.mini-back {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #caa866;
  background: radial-gradient(circle at 50% 35%, #2c2360, #120d33);
  box-shadow: inset 0 0 0 6rpx rgba(216, 178, 92, 0.18), 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mini-card.is-picked { transform: translateY(-16rpx); }
.mini-card.is-picked .mini-back {
  border-color: #d8b25c;
  box-shadow: inset 0 0 0 6rpx rgba(216, 178, 92, 0.35), 0 0 32rpx rgba(216, 178, 92, 0.55), 0 16rpx 32rpx rgba(0, 0, 0, 0.4);
}
.pick-badge {
  position: absolute;
  top: -14rpx;
  right: -4rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #e8c879, #b78d3a);
  color: #2a1f04;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}
.back-emblem { color: #d8b25c; font-size: 44rpx; }
.back-emblem.big { font-size: 68rpx; }

.btn-confirm { width: 360rpx; margin: 0 auto; }

/* 揭示 */
.reveal-head { text-align: center; margin: 52rpx 0 44rpx; }
.slots { display: flex; justify-content: center; gap: 16rpx; }
.slot {
  position: relative;
  width: 200rpx;
  height: 344rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.slot-label {
  position: absolute;
  top: -44rpx;
  font-size: 25rpx;
  letter-spacing: 4rpx;
  color: #d8b25c;
}
.slot-card { width: 100%; height: 100%; perspective: 2200rpx; }
.card3d {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.65s ease;
}
.slot.is-flipped .card3d { transform: rotateY(180deg); }
.card-face {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  backface-visibility: hidden;
  overflow: hidden;
}
.card-back {
  border: 1rpx solid #caa866;
  background: radial-gradient(circle at 50% 35%, #2c2360, #120d33);
  box-shadow: inset 0 0 0 8rpx rgba(216, 178, 92, 0.18), 0 16rpx 44rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-front {
  transform: rotateY(180deg);
  border: 1rpx solid #caa866;
  background: #120d33;
}
.card-img { width: 100%; height: 100%; }
.card-front.reversed .card-img { transform: rotate(180deg); }
.card-front.img-error .card-img { display: none; }
.card-front.img-error {
  background: repeating-linear-gradient(45deg, #1b1540 0 16rpx, #141033 16rpx 32rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-error-text { font-size: 24rpx; color: #d8b25c; }

.reveal-actions { text-align: center; margin-top: 56rpx; min-height: 88rpx; }

.reading {
  margin-top: 36rpx;
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(216, 178, 92, 0.28);
  border-radius: 32rpx;
  background: rgba(21, 15, 51, 0.72);
}
.reading-tag { text-align: center; color: #d8b25c; font-size: 26rpx; letter-spacing: 4rpx; margin-bottom: 24rpx; }
.reading-line { font-size: 28rpx; line-height: 1.9; color: #efe8d8; }
.btn-ghost {
  margin: 28rpx auto 0;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(216, 178, 92, 0.28);
  color: #d8b25c;
  font-size: 27rpx;
  display: inline-block;
}
.btn-retry { color: #e08b8b; border-color: rgba(224, 139, 139, 0.5); display: block; }
